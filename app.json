{
  "expo": {
    "name": "MDUMENI",
    "slug": "mdumeni",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "mdumeni",
    "splash": {
      "backgroundColor": "#1A5C2A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.intellifarming.mdumeni"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A5C2A"
      },
      "package": "com.intellifarming.mdumeni",
      "permissions": [
        "BLUETOOTH",
        "BLUETOOTH_ADMIN",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_NETWORK_STATE",
        "INTERNET"
      ]
    },
    "plugins": [
      "expo-sqlite",
      "expo-font"
    ]
  }
}
